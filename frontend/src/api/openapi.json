                }
              }
            }
          }
        }
      }
    },
    "/api/v1/scenarios/default": {
      "get": {
        "summary": "Default Scenario",
        "operationId": "default_scenario_api_v1_scenarios_default_get",
        "responses": {
          "200": {
            "description": "Successful Response",
