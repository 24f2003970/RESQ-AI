          "title": "Status",
          "type": "string"
        },
        "started_at_utc": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Started At Utc"
        },
        "completed_at_utc": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Completed At Utc"
        },
        "duration_ms": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Duration Ms"
        },
        "input_hash": {
          "title": "Input Hash",
          "type": "string"
        },
        "input_snapshot_ref": {
          "title": "Input Snapshot Ref",
          "type": "string"
        },
        "output_summary": {
          "additionalProperties": true,
          "title": "Output Summary",
          "type": "object"
        },
        "numerical_evidence": {
          "additionalProperties": true,
          "title": "Numerical Evidence",
          "type": "object"
