{
  "$defs": {
    "AgentEventEnvelope": {
      "additionalProperties": false,
      "properties": {
        "event_id": {
          "title": "Event Id",
          "type": "string"
        },
        "event_type": {
          "title": "Event Type",
          "type": "string"
        },
        "scenario_id": {
          "title": "Scenario Id",
          "type": "string"
        },
        "scenario_epoch": {
          "title": "Scenario Epoch",
          "type": "integer"
        },
        "simulation_tick": {
          "title": "Simulation Tick",
          "type": "integer"
        },
        "simulation_state_version": {
          "title": "Simulation State Version",
          "type": "integer"
        },
        "infrastructure_revision": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Infrastructure Revision"
        },
        "created_at_utc": {
          "format": "date-time",
          "title": "Created At Utc",
          "type": "string"
        },
        "source_module": {
          "title": "Source Module",
          "type": "string"
        },
        "affected_entity_ids": {
          "items": {
            "type": "string"
          },
          "title": "Affected Entity Ids",
          "type": "array"
        },
        "payload": {
          "additionalProperties": true,
          "title": "Payload",
          "type": "object"
        },
        "correlation_id": {
          "title": "Correlation Id",
          "type": "string"
        },
        "causation_event_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Causation Event Id"
        },
        "outbox_insert_ms": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Outbox Insert Ms"
        }
      },
      "required": [
        "event_id",
        "event_type",
        "scenario_id",
        "scenario_epoch",
        "simulation_tick",
        "simulation_state_version",
        "created_at_utc",
        "source_module",
        "correlation_id"
      ],
      "title": "AgentEventEnvelope",
      "type": "object"
    },
    "AgentRunRecord": {
      "properties": {
        "run_id": {
          "title": "Run Id",
          "type": "string"
        },
        "event_id": {
          "title": "Event Id",
          "type": "string"
        },
        "correlation_id": {
          "title": "Correlation Id",
          "type": "string"
        },
        "scenario_id": {
          "title": "Scenario Id",
          "type": "string"
        },
        "scenario_epoch": {
          "title": "Scenario Epoch",
          "type": "integer"
        },
        "simulation_state_version": {
          "title": "Simulation State Version",
          "type": "integer"
        },
        "infrastructure_revision": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Infrastructure Revision"
        },
        "agent_name": {
          "title": "Agent Name",
          "type": "string"
        },
        "status": {
          "enum": [
            "waiting",
            "running",
            "completed",
            "skipped",
            "failed",
            "superseded",
            "degraded"
