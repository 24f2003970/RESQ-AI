          "type": "string"
        },
        "responsibility": {
          "title": "Responsibility",
          "type": "string"
        },
        "position": {
          "title": "Position",
          "type": "integer"
        }
      },
      "required": [
        "name",
        "title",
        "responsibility",
        "position"
      ],
      "title": "AgentDefinition",
      "type": "object"
    },
    "AgentRunRecord": {
      "properties": {
        "run_id": {
          "title": "Run Id",
          "type": "string"
        },
        "event_id": {
          "title": "Event Id",
          "type": "string"
        },
        "correlation_id": {
          "title": "Correlation Id",
          "type": "string"
        },
        "scenario_id": {
          "title": "Scenario Id",
          "type": "string"
        },
        "scenario_epoch": {
          "title": "Scenario Epoch",
          "type": "integer"
        },
        "simulation_state_version": {
          "title": "Simulation State Version",
          "type": "integer"
        },
        "infrastructure_revision": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Infrastructure Revision"
        },
        "agent_name": {
          "title": "Agent Name",
          "type": "string"
        },
        "status": {
          "enum": [
            "waiting",
            "running",
            "completed",
            "skipped",
            "failed",
            "superseded",
            "degraded"
          ],
          "title": "Status",
          "type": "string"
        },
        "started_at_utc": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Started At Utc"
        },
        "completed_at_utc": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Completed At Utc"
        },
        "duration_ms": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Duration Ms"
        },
        "input_hash": {
          "title": "Input Hash",
          "type": "string"
        },
        "input_snapshot_ref": {
          "title": "Input Snapshot Ref",
          "type": "string"
        },
        "output_summary": {
          "additionalProperties": true,
          "title": "Output Summary",
          "type": "object"
        },
        "numerical_evidence": {
          "additionalProperties": true,
          "title": "Numerical Evidence",
          "type": "object"
        },
        "proposed_action": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Proposed Action"
        },
        "explanation": {
          "default": "",
          "title": "Explanation",
          "type": "string"
        },
        "error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error"
        },
        "attempt": {
          "default": 0,
          "title": "Attempt",
          "type": "integer"
        }
      },
      "required": [
        "run_id",
        "event_id",
        "correlation_id",
        "scenario_id",
        "scenario_epoch",
        "simulation_state_version",
        "infrastructure_revision",
        "agent_name",
        "status",
        "input_hash",
        "input_snapshot_ref"
      ],
