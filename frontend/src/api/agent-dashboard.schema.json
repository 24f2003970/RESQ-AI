    "AgentTrace": {
      "properties": {
        "trace_id": {
          "title": "Trace Id",
          "type": "string"
        },
        "event_id": {
          "title": "Event Id",
          "type": "string"
        },
        "correlation_id": {
          "title": "Correlation Id",
          "type": "string"
        },
        "scenario_id": {
          "title": "Scenario Id",
          "type": "string"
        },
        "scenario_epoch": {
          "title": "Scenario Epoch",
          "type": "integer"
        },
        "simulation_state_version": {
          "title": "Simulation State Version",
          "type": "integer"
        },
        "infrastructure_revision": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Infrastructure Revision"
