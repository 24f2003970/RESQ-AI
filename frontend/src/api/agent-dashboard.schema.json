          "title": "Status",
          "type": "string"
        },
        "plan_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Plan Id"
        },
        "summary": {
          "title": "Summary",
          "type": "string"
        },
        "evidence": {
          "additionalProperties": true,
          "title": "Evidence",
          "type": "object"
        },
        "created_at_utc": {
          "format": "date-time",
          "title": "Created At Utc",
          "type": "string"
        }
      },
      "required": [
        "trace_id",
        "event_id",
        "correlation_id",
        "scenario_id",
        "scenario_epoch",
        "simulation_state_version",
        "infrastructure_revision",
        "status",
        "summary",
        "created_at_utc"
      ],
      "title": "AgentTrace",
      "type": "object"
    }
  },
  "properties": {
    "scenario_id": {
      "title": "Scenario Id",
      "type": "string"
    },
    "scenario_epoch": {
      "title": "Scenario Epoch",
      "type": "integer"
    },
    "simulation_state_version": {
      "title": "Simulation State Version",
      "type": "integer"
    },
    "infrastructure_revision": {
      "title": "Infrastructure Revision",
      "type": "integer"
    },
    "definitions": {
      "items": {
        "$ref": "#/$defs/AgentDefinition"
      },
      "title": "Definitions",
      "type": "array"
    },
    "latest_runs": {
      "items": {
        "$ref": "#/$defs/AgentRunRecord"
      },
      "title": "Latest Runs",
      "type": "array"
    },
    "latest_trace": {
      "anyOf": [
        {
          "$ref": "#/$defs/AgentTrace"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "pending_events": {
      "default": 0,
      "title": "Pending Events",
      "type": "integer"
    },
    "available_ground_units": {
      "default": 0,
      "title": "Available Ground Units",
      "type": "integer"
    },
    "reserved_ground_units": {
      "items": {
        "type": "string"
      },
      "title": "Reserved Ground Units",
      "type": "array"
    },
    "commander_action_required": {
      "default": false,
      "title": "Commander Action Required",
      "type": "boolean"
    },
    "approved_route_review_required": {
      "default": false,
      "title": "Approved Route Review Required",
      "type": "boolean"
    },
    "approved_route_review_plan_ids": {
      "items": {
        "type": "string"
      },
      "title": "Approved Route Review Plan Ids",
      "type": "array"
    },
    "manual_closure_road_ids": {
      "items": {
        "type": "string"
      },
      "title": "Manual Closure Road Ids",
      "type": "array"
    }
